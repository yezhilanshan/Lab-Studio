# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/
/milkdown-main/
/milkdown-main.zip

# OS metadata
.DS_Store

# Vendored dependency build tooling (dist/ and package.json are kept so `file:vendor/excalidraw` resolves)
/vendor/excalidraw/node_modules/

# Unrelated nested checkout
/Galaxy/

# Debug artefacts: screenshots, CDP dumps, scratch probes
/scratch/
/shots/
/.screenshots/
/.playwright-mcp/

# Other tools' local state and dated report drops
/.workbuddy/
/2026-11-12/

# Checkout-local deployment state (binding ids / project id)
/.openai/
/wrangler-export.json
